# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SERVIDOR
# ==============================================================================
PORT=3000
NODE_ENV=development

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:19006

# ==============================================================================
# CONEXIÓN A LA BASE DE DATOS MYSQL 8.0
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=psicohabitos_db
DB_TIMEZONE=-03:00

# ==============================================================================
# SEGURIDAD Y AUTENTICACIÓN JWT
# Clave secreta persistente para mantener sesiones activas tras reiniciar
# ==============================================================================
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui_minimo_32_caracteres
JWT_EXPIRES_IN=7d

# ==============================================================================
# SERVICIO OFICIAL DE CORREOS PSICOHÁBITOS (Gmail SMTP)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=psicohabitos.ia@gmail.com
SMTP_FROM="PsicoHábitos" <psicohabitos.ia@gmail.com>

# 🔑 Contraseña de Aplicación de 16 caracteres de Google:
# - MODO CONSOLA (Por defecto): Si se deja vacía, el servidor imprimirá los
#   códigos OTP de 6 dígitos en la terminal de la consola.
# - MODO ENVÍO REAL: Pega aquí la clave de aplicación compartida por el equipo.
SMTP_PASS=tu_clave_de_aplicacion_de_16_caracteres
